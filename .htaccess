# Použije se jen tehdy, když document root subdomény NEJDE nastavit na /public.
# Vše přesměruje do public/, takže .env, storage/ ani vendor/ nejsou z webu dostupné.
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
