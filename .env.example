APP_NAME="PAP Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.servicepap.com

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Webglobe MySQL – pro test vlastní databáze, ne produkční!
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="servis@servicepap.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platnost tokenů v minutách (prázdné = neomezeně; mobilní aplikace drží token dlouho)
SANCTUM_EXPIRATION=

# --- PAP Service ---
# Dlouhé náhodné řetězce (např. openssl rand -hex 32)
PAP_CRON_TOKEN=
PAP_MAINTENANCE_TOKEN=
PAP_TICK_SECONDS=45
PAP_UPLOAD_MAX_KB=15360

# Admin se založí při prvním "seed"
PAP_ADMIN_EMAIL=
PAP_ADMIN_PASSWORD=
# Testovací účty (heslo demo1234) – jen na testovací subdoméně
PAP_SEED_DEMO=false

# Původní DB servicepap pro import (jen čtení)
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
